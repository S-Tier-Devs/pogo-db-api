{
  "name": "pogo-db-api",
  "version": "1.0.0",
  "description": "Custom-tailored static JSON API for Pokemon GO data with computed DPS stats",
  "type": "module",
  "scripts": {
    "build": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["pokemon-go", "api", "static", "dps"],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.3"
  }
}
